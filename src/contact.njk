---
title: "Contact — Yellow Bee"
description: "Got a question about our menu, catering, wholesale, or just want to say hi? Send a note."
permalink: /contact/index.html
tickerItems:
  - "Get In Touch"
  - "922 E Yesler Way · Seattle"
  - "shopyellowbee@gmail.com"
  - "(206) 538-0839"
---

{% extends "base.njk" %}

{% block head_extra %}
<link rel="stylesheet" href="/assets/css/page-contact.css?v={{ buildHash }}">
{% endblock %}

{% block content %}

<section class="ct-section ct-section--first" id="message">
  <div class="ct-mega" aria-hidden="true">Contact</div>
  <div class="sec-container">
    <header class="ct-section-head reveal">
      <div class="sec-mark sec-mark--dark">Chapter 01 / {{ contact.chapter }}</div>
      <h2>{{ contact.headline }}</h2>
      <p class="ct-section-meta">{{ contact.meta }}</p>
    </header>

    <div class="ct-panel">

      <aside class="ct-aside reveal-left">
        <div class="ct-aside-block">
          <div class="ct-aside-label">Email</div>
          <a class="ct-aside-link" href="mailto:{{ site.email }}">{{ site.email }}</a>
        </div>

        <div class="ct-aside-block">
          <div class="ct-aside-label">Flagship</div>
          <p class="ct-aside-text">
            {{ site.address.street }}<br>
            {{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}
          </p>
        </div>

        {% set phone = apnosh.client.phone or site.phone %}
        <div class="ct-aside-block">
          <div class="ct-aside-label">Phone</div>
          <a class="ct-aside-link ct-aside-link--sm" href="tel:{{ phone | replace('(','') | replace(')','') | replace(' ','') | replace('-','') }}">{{ phone }}</a>
        </div>

        {# Hours — managed in the Apnosh portal (apnosh.hours). Updates
           there trigger a rebuild and refresh this block automatically. #}
        {% if apnosh.hours %}
        <div class="ct-aside-block">
          <div class="ct-aside-label">Hours</div>
          <ul class="ct-hours">
            {% for key in ['mon','tue','wed','thu','fri','sat','sun'] %}
              {% set periods = apnosh.hours[key] %}
              <li class="ct-hours-row">
                <span class="ct-hours-day">{{ key | dayLabel }}</span>
                <span class="ct-hours-time">
                  {%- if periods and periods.length -%}
                    {{ periods[0].open | time12 }} – {{ periods[0].close | time12 }}
                  {%- else -%}
                    Closed
                  {%- endif -%}
                </span>
              </li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}

        <div class="ct-aside-block">
          <div class="ct-aside-label">Social</div>
          <a class="ct-aside-link ct-aside-link--sm" href="{{ site.socials.instagram }}" target="_blank" rel="noopener">{{ site.handle }}</a>
        </div>

      </aside>

      <form class="ct-form reveal-right" data-yb-form onsubmit="handleContactSubmit(event)">
        <div class="ct-row">
          <div class="ct-group">
            <label for="fname">First Name <span aria-hidden="true">*</span></label>
            <input type="text" id="fname" name="fname" required>
          </div>
          <div class="ct-group">
            <label for="lname">Last Name <span aria-hidden="true">*</span></label>
            <input type="text" id="lname" name="lname" required>
          </div>
        </div>

        <div class="ct-row">
          <div class="ct-group">
            <label for="email">Email <span aria-hidden="true">*</span></label>
            <input type="email" id="email" name="email" required>
          </div>
          <div class="ct-group">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" placeholder="(206) 555-0000">
          </div>
        </div>

        <div class="ct-group">
          <label for="subject">What's This About? <span aria-hidden="true">*</span></label>
          <select id="subject" name="subject" required>
            <option value="">Select a topic</option>
            {% for s in contact.subjects %}
            <option value="{{ s.value }}">{{ s.label }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="ct-group">
          <label for="message">Your Message <span aria-hidden="true">*</span></label>
          <textarea id="message" name="message" rows="6" placeholder="Tell us what's on your mind." required></textarea>
        </div>

        <button type="submit" class="btn btn-yellow ct-submit">Send Message &rarr;</button>
        <p class="ct-error" role="alert" hidden></p>

        <p class="ct-footnote">Your info stays with our team.</p>
      </form>

    </div>
  </div>
</section>

{% endblock %}

{% block scripts %}
<script>
// Send the message to Yellow Bee's inbox in the Apnosh portal (assets/js/forms.js). On a build
// without APNOSH_SLUG, open the user's email client pre-filled to {{ site.email }} instead.
function handleContactSubmit(e) {
  e.preventDefault();
  const f = e.target;
  const v = id => (f.querySelector('#' + id) || {}).value || '';
  const subjectMap = {
    general: 'General Question', menu: 'Menu & Food',
    catering: 'Catering & Events', wholesale: 'Wholesale / Vendors',
    feedback: 'Feedback',
  };
  const subjectLabel = subjectMap[v('subject')] || v('subject') || 'General';
  const fullName = (v('fname') + ' ' + v('lname')).trim();
  const btn = f.querySelector('.ct-submit');
  const original = btn.innerHTML;
  const err = f.querySelector('.ct-error');

  if (window.YBForms && YBForms.ready) {
    const kind = { catering: 'catering', feedback: 'feedback' }[v('subject')] || 'contact';
    btn.disabled = true;
    btn.innerHTML = 'Sending…';
    err.hidden = true;
    YBForms.send(f, kind, { name: fullName, email: v('email'), phone: v('phone'), topic: subjectLabel, message: v('message') }).then(r => {
      btn.disabled = false;
      if (!r.ok) {
        btn.innerHTML = original;
        err.textContent = r.error;
        err.hidden = false;
        return;
      }
      f.reset();
      btn.innerHTML = '✓ Sent. We’ll get back to you soon';
      btn.classList.add('is-submitted');
      setTimeout(() => {
        btn.innerHTML = original;
        btn.classList.remove('is-submitted');
      }, 6000);
    });
    return;
  }

  const fields = [
    ['Name', fullName],
    ['Email', v('email')],
    ['Phone', v('phone')],
    ['Topic', subjectLabel],
    ['', ''],
    ['Message', v('message')],
  ];
  const body = fields.map(([k, val]) => k ? (k + ': ' + val) : '').join('\n');
  const subject = 'Yellow Bee — ' + subjectLabel + (fullName ? ' (' + fullName + ')' : '');
  const url = 'mailto:{{ site.email }}'
    + '?subject=' + encodeURIComponent(subject)
    + '&body=' + encodeURIComponent(body);
  window.location.href = url;

  btn.innerHTML = '✓ Email opened — send to complete';
  btn.classList.add('is-submitted');
  setTimeout(() => {
    btn.innerHTML = original;
    btn.classList.remove('is-submitted');
  }, 6000);
}
</script>
{% endblock %}
