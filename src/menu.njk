---
title: "Menu — Yellow Bee"
description: "Fresh banh mi, handcrafted boba, bagels baked daily, and sweet pastries. Made to order at Yellow Bee."
permalink: /menu/index.html
tickerItems:
  - "Menu · Made to Order Daily"
  - "$10 Banh Mi"
  - "Bagels Baked Fresh"
  - "Seasonal Boba"
  - "Danish · Cookies · Pastries"
---

{% extends "base.njk" %}

{% block head_extra %}
<link rel="stylesheet" href="/assets/css/page-menu.css?v={{ buildHash }}">
{% endblock %}

{% block content %}

<!-- SEASONAL DROP -->
<section class="menu-section menu-section--paper menu-seasonal menu-section--first" id="seasonal">
  <div class="menu-section-mega menu-section-mega--dark" aria-hidden="true">Season</div>
  <div class="sec-container">
    {% for item in seasonal.items %}
    <div class="seasonal-feature reveal">
      <figure class="seasonal-poster">
        <img src="/{{ item.poster }}" alt="{{ item.name }} — {{ item.season }}" loading="lazy" decoding="async">
        <figcaption class="seasonal-poster-cap">{{ item.season }}</figcaption>
      </figure>

      <div class="seasonal-body">
        <div class="seasonal-eyebrow">{{ seasonal.eyebrow }}</div>
        <h2 class="seasonal-name">{{ item.name }}.</h2>
        <p class="seasonal-tagline">{{ item.tagline }}</p>
        <p class="seasonal-desc">{{ item.description }}</p>

        <dl class="seasonal-spec">
          <dt>Price</dt>
          <dd>${{ item.price }}</dd>
          <dt>{{ item.addOn.label }}</dt>
          <dd>{{ item.addOn.price }}</dd>
          <dt>Window</dt>
          <dd>{{ item.available }}</dd>
        </dl>

        <div class="seasonal-ctas">
          <a href="#drinks-menu" class="btn btn-yellow">See Full Drinks</a>
          <a href="/locations/" class="btn btn-outline-dark">Find A Store</a>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<!--
  BANH MI -- now driven by Apnosh's menu_items table.

  The Banh Mi list and prices come from apnosh.menu['Banh Mi'] (managed in
  the Apnosh portal at /dashboard/website/manage). Yellow Bee staff can
  edit any price, add a new item, mark featured -- changes show up here
  on the next build.

  Photos and descriptions are still pulled from the local _data/menu.json
  by name match where available (gives existing items their rich card
  treatment). New API items render as a clean name+price tile.
-->
<section class="menu-section menu-section--dark" id="banh-mi">
  <div class="menu-section-mega" aria-hidden="true">Banh Mi</div>
  <div class="sec-container">
    <header class="menu-section-head reveal">
      <div class="sec-mark">Chapter 02 / {{ menu.banhmi.label }}</div>
      <h2>{{ menu.banhmi.headline }}</h2>
      <p class="menu-section-meta">{{ menu.banhmi.meta }}</p>
    </header>

    {# Banh Mi list. Prefer Apnosh portal data ONLY when the portal has
       at least as many items as the local fallback — otherwise use
       local. Prevents a partial/broken portal state from silently
       hiding most of the menu (we hit this when the portal had only
       "Spicy Tuna Banh Mi" and dropped the other 6). #}
    {%- set banhMiItems = menu.banhmi.items -%}
    {%- set banhMiFromPortal = false -%}
    {%- if apnosh.menu and apnosh.menu['Banh Mi'] and apnosh.menu['Banh Mi'].items.length >= menu.banhmi.items.length -%}
      {%- set banhMiItems = apnosh.menu['Banh Mi'].items -%}
      {%- set banhMiFromPortal = true -%}
    {%- endif -%}

    <div class="menu-grid menu-grid--text">
      {% for item in banhMiItems %}
        {%- if banhMiFromPortal -%}
          {%- set legacy = (menu.banhmi.items | selectattr('name', 'equalto', item.name) | first)
              or (menu.banhmi.items | selectattr('name', 'equalto', item.name | replace('The ', '')) | first) -%}
          {%- set itemName = item.name -%}
          {%- set itemPrice = item.price -%}
          {%- set itemDesc = item.description or (legacy and legacy.desc) -%}
        {%- else -%}
          {%- set itemName = item.name -%}
          {%- set itemPrice = item.price -%}
          {%- set itemDesc = item.desc -%}
        {%- endif -%}
        <article class="menu-card menu-card--text reveal d{{ loop.index }}" data-num="№ 0{{ loop.index }}">
          <div class="menu-card-body">
            <div class="menu-card-head">
              <h3 class="menu-card-name">{{ itemName }}</h3>
              <span class="menu-card-price">{{ itemPrice }}</span>
            </div>
            {% if itemDesc %}
            <p class="menu-card-desc">{{ itemDesc }}</p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {# SAUCES — inline under Banh Mi. Prefer portal when it has as many
       or more; otherwise use local menu.banhmi.sauces list. #}
    {%- set sauceList = menu.banhmi.sauces.list -%}
    {%- if apnosh.menu and apnosh.menu['Sauces'] and apnosh.menu['Sauces'].modifiers.length >= menu.banhmi.sauces.list.length -%}
      {%- set sauceList = [] -%}
      {%- for s in apnosh.menu['Sauces'].modifiers -%}
        {%- set sauceList = sauceList.concat([s]) -%}
      {%- endfor -%}
    {%- endif -%}
    {% if sauceList.length > 0 %}
    <div class="menu-toppings menu-toppings--light reveal" style="margin-top:1.5rem;" id="sauces">
      <div class="menu-toppings-head">
        <div class="menu-toppings-label">{{ menu.banhmi.sauces.label }}</div>
        <div class="menu-toppings-price">House made</div>
      </div>
      <div class="menu-toppings-list">
        {% for s in sauceList %}
        <span class="menu-topping-tag">
          {{ s.name }}{% if s.price %} <em style="opacity:.7">({{ s.price }})</em>{% endif %}
        </span>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
</section>

<!-- BAGELS -- "Make It a Bagel Banh Mi". Bread choices come from
     apnosh.menu['Bagel options'] (modifiers). Yellow Bee staff add new
     bagel types in the dashboard. -->
<section class="menu-section menu-section--paper" id="bagels">
  <div class="menu-section-mega menu-section-mega--dark" aria-hidden="true">Bagels</div>
  <div class="sec-container">
    <header class="menu-section-head reveal">
      <div class="sec-mark sec-mark--dark">Chapter 03 / {{ menu.bagels.label }}</div>
      <h2>Make it a Bagel Banh Mi.</h2>
      <p class="menu-section-meta menu-section-meta--dark"><em>Same price as banh mi.</em></p>
    </header>

    {# Bagels render from local _data/menu.json so each card gets its
       paired photo + flavor description. The Apnosh portal modifier
       list ("Bagel options") was joined-by-name previously, but its
       names don't line up with the local entries (portal sends
       "Plain bagel" vs local "Plain", etc.) so the join silently
       collapsed every card to the first local item. Locally-driven
       avoids the mismatch entirely. #}
    <div class="bagel-grid reveal">
      {% for item in menu.bagels.items %}
      <article class="bagel-card d{{ loop.index }}">
        <div class="bagel-card-img">
          <img src="/{{ item.image }}" alt="{{ item.alt }}" loading="lazy" decoding="async">
        </div>
        <div class="bagel-card-body">
          <h3 class="bagel-card-name">{{ item.name }}</h3>
          <p class="bagel-card-desc">{{ item.desc }}</p>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<!--
  BOBA (formerly "Seasonal Boba" -- renamed per change-request PDF).
  Drinks come from apnosh.menu['Boba'].items. Yellow Bee staff add new
  drinks in the dashboard. Photos still come from local _data/drinks.json
  by name match where available; new drinks render as clean name+price tiles.
  Toppings come from apnosh.menu['Toppings'].modifiers.
-->
<section class="menu-section menu-section--dark" id="drinks-menu">
  <div class="menu-section-mega" aria-hidden="true">Sip</div>
  <div class="sec-container">
    <header class="menu-section-head reveal">
      <div class="sec-mark">Chapter 04 / The Bar</div>
      <h2>Boba.</h2>
      <p class="menu-section-meta">Handcrafted milk teas, fruit teas, and smoothies.</p>
    </header>

    {# Choose Boba source: prefer portal when it has at least as many items
       as the local list; otherwise use local (protects against portal
       being partial/misconfigured and hiding most of the menu). #}
    {%- set bobaSource = drinks.items -%}
    {%- set bobaFromPortal = false -%}
    {%- if apnosh.menu and apnosh.menu['Boba'] and apnosh.menu['Boba'].items.length >= drinks.items.length -%}
      {%- set bobaSource = apnosh.menu['Boba'].items -%}
      {%- set bobaFromPortal = true -%}
    {%- endif -%}

    {# Feature up to 3 drinks (items marked featured in drinks.json).
       Use the branded placeholder SVG for now — the store team can
       drop real product shots into /photos/drinks/ later and wire
       them per-item via `image` in drinks.json. #}
    {%- set bobaFeatured = [] -%}
    {%- set bobaTeas = [] -%}
    {%- set bobaSmoothies = [] -%}
    {%- for item in bobaSource -%}
      {%- if item.featured and bobaFeatured.length < 3 -%}
        {%- set bobaFeatured = bobaFeatured.concat([item]) -%}
      {%- endif -%}
      {%- if 'Smoothie' in item.name -%}
        {%- set bobaSmoothies = bobaSmoothies.concat([item]) -%}
      {%- else -%}
        {%- set bobaTeas = bobaTeas.concat([item]) -%}
      {%- endif -%}
    {%- endfor -%}

    {% if bobaFeatured.length > 0 %}
    <div class="menu-drinks-grid menu-drinks-grid--featured">
      {% for item in bobaFeatured %}
        {%- set imgSrc = item.photoUrl or (item.image and ('/' + item.image)) or '/photos/placeholders/special-placeholder.svg' -%}
      <article class="drink-menu-card reveal d{{ loop.index }}">
        <div class="drink-menu-card-img">
          <img src="{{ imgSrc }}" alt="{{ item.name }}" loading="lazy" decoding="async">
        </div>
        <div class="drink-menu-card-name">{{ item.name }}</div>
        <div class="drink-menu-card-price">{{ item.price }}</div>
      </article>
      {% endfor %}
    </div>
    {% endif %}

    {% if bobaTeas.length > 0 or bobaSmoothies.length > 0 %}
    <div class="boba-list-cols reveal" style="margin-top:{% if bobaFeatured.length > 0 %}2.5rem{% else %}0{% endif %};">
      {% if bobaTeas.length > 0 %}
      <div class="boba-list-col">
        <h3 class="boba-list-heading">Teas</h3>
        <ul class="menu-list menu-list--dark">
          {% for item in bobaTeas %}
          <li class="menu-list-item">
            <span class="menu-list-name">{{ item.name }}</span>
            <span class="menu-list-dots" aria-hidden="true"></span>
            <span class="menu-list-price">{{ item.price }}</span>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
      {% if bobaSmoothies.length > 0 %}
      <div class="boba-list-col">
        <h3 class="boba-list-heading">Smoothies</h3>
        <ul class="menu-list menu-list--dark">
          {% for item in bobaSmoothies %}
          <li class="menu-list-item">
            <span class="menu-list-name">{{ item.name }}</span>
            <span class="menu-list-dots" aria-hidden="true"></span>
            <span class="menu-list-price">{{ item.price }}</span>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
    </div>
    {% endif %}

    {% if apnosh.menu and apnosh.menu['Toppings'] and apnosh.menu['Toppings'].modifiers.length > 0 %}
    <div class="menu-toppings reveal">
      <div class="menu-toppings-head">
        <div class="menu-toppings-label">Toppings</div>
        <div class="menu-toppings-price">House-made</div>
      </div>
      <div class="menu-toppings-list">
        {% for t in apnosh.menu['Toppings'].modifiers %}
        <span class="menu-topping-tag">{{ t.name }}{% if t.price %} <em style="opacity:.7">({{ t.price }})</em>{% endif %}</span>
        {% endfor %}
      </div>
    </div>
    {% else %}
    <div class="menu-toppings reveal">
      <div class="menu-toppings-head">
        <div class="menu-toppings-label">{{ drinks.toppings.label }}</div>
        <div class="menu-toppings-price">{{ drinks.toppings.price }}</div>
      </div>
      <div class="menu-toppings-list">
        {% for t in drinks.toppings.list %}
        <span class="menu-topping-tag">{{ t }}</span>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
</section>

<!--
  ESPRESSO -- new section per change-request PDF. Items from
  apnosh.menu['Espresso']. Featured items (currently Pandan Matcha
  Delight) get a highlight treatment. Milk options from
  apnosh.menu['Milk options'].modifiers.
-->
{# Espresso — always render, using portal when it has at least as many
   items as local, otherwise local fallback. Local data lives in
   menu.espresso (menu.json). #}
{%- set espressoSource = menu.espresso.items -%}
{%- set espressoFromPortal = false -%}
{%- if apnosh.menu and apnosh.menu['Espresso'] and apnosh.menu['Espresso'].items.length >= menu.espresso.items.length -%}
  {%- set espressoSource = apnosh.menu['Espresso'].items -%}
  {%- set espressoFromPortal = true -%}
{%- endif -%}

{%- if espressoFromPortal -%}
  {%- set featuredEspresso = espressoSource | selectattr('isFeatured') | first -%}
  {%- set featuredName = featuredEspresso.name -%}
  {%- set featuredDesc = featuredEspresso.description -%}
  {%- set featuredPrice = featuredEspresso.price -%}
  {%- set featuredPhoto = featuredEspresso.photoUrl -%}
{%- else -%}
  {%- set featuredEspresso = menu.espresso.featured -%}
  {%- set featuredName = menu.espresso.featured.name -%}
  {%- set featuredDesc = menu.espresso.featured.desc -%}
  {%- set featuredPrice = menu.espresso.featured.price -%}
  {%- set featuredPhoto = false -%}
{%- endif -%}

<section class="menu-section menu-section--paper" id="espresso">
  <div class="menu-section-mega menu-section-mega--dark" aria-hidden="true">Espresso</div>
  <div class="sec-container">
    <header class="menu-section-head reveal">
      <div class="sec-mark sec-mark--dark">Chapter 05 / {{ menu.espresso.label }}</div>
      <h2>{{ menu.espresso.headline }}</h2>
      <p class="menu-section-meta menu-section-meta--dark">{{ menu.espresso.meta }}</p>
    </header>

    <div class="espresso-layout reveal">
      {% if featuredEspresso %}
      <article class="menu-feature menu-feature--vertical">
        {% if featuredPhoto %}
        <figure class="menu-feature-img">
          <span class="menu-feature-tag">Featured</span>
          <img src="{{ featuredPhoto }}" alt="{{ featuredName }}" loading="lazy" decoding="async">
        </figure>
        {% else %}
        <div class="menu-feature-body">
          <div class="menu-feature-eyebrow">Featured</div>
          <h3 class="menu-feature-name">{{ featuredName }}</h3>
          <p class="menu-feature-tagline">{{ featuredDesc or "Our signature drink." }}</p>
          <div class="menu-feature-price">{{ featuredPrice }}</div>
        </div>
        {% endif %}
        {% if featuredPhoto %}
        <div class="menu-feature-body">
          <h3 class="menu-feature-name">{{ featuredName }}</h3>
          <p class="menu-feature-tagline">{{ featuredDesc or "Our signature drink." }}</p>
          <div class="menu-feature-price">{{ featuredPrice }}</div>
        </div>
        {% endif %}
      </article>
      {% endif %}

      <ul class="menu-list">
        {% for item in espressoSource %}
          {%- set isFeatured = espressoFromPortal and item.isFeatured -%}
          {% if not isFeatured %}
          <li class="menu-list-item">
            <span class="menu-list-name">{{ item.name }}</span>
            <span class="menu-list-dots" aria-hidden="true"></span>
            <span class="menu-list-price">{{ item.price }}</span>
          </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>

    {# Milk options — prefer portal modifiers, fall back to local list. #}
    {%- set milkOptions = menu.espresso.milkOptions.list -%}
    {%- if apnosh.menu and apnosh.menu['Milk options'] and apnosh.menu['Milk options'].modifiers.length >= menu.espresso.milkOptions.list.length -%}
      {%- set milkOptions = [] -%}
      {%- for m in apnosh.menu['Milk options'].modifiers -%}
        {%- set milkOptions = milkOptions.concat([m.name]) -%}
      {%- endfor -%}
    {%- endif -%}
    {% if milkOptions.length > 0 %}
    <div class="menu-toppings menu-toppings--light reveal" style="margin-top:2rem;">
      <div class="menu-toppings-head">
        <div class="menu-toppings-label">{{ menu.espresso.milkOptions.label }}</div>
        <div class="menu-toppings-price">No surcharge</div>
      </div>
      <div class="menu-toppings-list">
        {% for m in milkOptions %}
        <span class="menu-topping-tag">{{ m }}</span>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
</section>

<!-- PASTRIES -->
<section class="menu-section menu-section--paper" id="pastries">
  <div class="menu-section-mega menu-section-mega--dark" aria-hidden="true">Sweet</div>
  <div class="sec-container">
    <header class="menu-section-head reveal">
      <div class="sec-mark sec-mark--dark">Chapter 05 / {{ menu.pastries.label }}</div>
      <h2>{{ menu.pastries.headline }}</h2>
      <p class="menu-section-meta menu-section-meta--dark">{{ menu.pastries.meta }}</p>
    </header>

    <div class="menu-pastries-grid">
      {% for item in menu.pastries.items %}
      <article class="pastry-card reveal d{{ loop.index }}">
        <div class="pastry-card-head">
          <h3 class="pastry-card-name">{{ item.name }}</h3>
          <span class="pastry-card-price">{{ item.price }}</span>
        </div>
        <p class="pastry-card-desc">{{ item.desc }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{% endblock %}
